@include "libc.lmi"
const TAPE_SIZE: i64 = 30000;
const SEEK_SET: i32 = 0;
const SEEK_END: i32 = 2;
fn build_jump_table(program: *u8, len: i64, table: *i64) -> void {
    let i: i64 = 0;
    while i < len {
        table[i] = -1;
        i = i + 1;
    }
    i = 0;
    while i < len {
        if program[i] == 91 {
            let depth: i64 = 1;
            let j: i64 = i + 1;
            while depth > 0 && j < len {
                if program[j] == 91 { depth = depth + 1; }
                else if program[j] == 93 { depth = depth - 1; }
                if depth > 0 { j = j + 1; }
            }
            if depth == 0 {
                table[i] = j;
                table[j] = i;
            }
        }
        i = i + 1;
    }
}

fn execute(program: *u8, len: i64, table: *i64) -> void {
    let tape = malloc(TAPE_SIZE as u64) as *u8;
    let ptr: i64 = 0;
    let pc: i64 = 0;
    let z: i64 = 0;
    while z < TAPE_SIZE {
        tape[z] = 0;
        z = z + 1;
    }

    while pc < len {
        let c = program[pc];
        if c == 62 {
            ptr = ptr + 1;
            if ptr >= TAPE_SIZE { ptr = 0; }
        } else if c == 60 {
            ptr = ptr - 1;
            if ptr < 0 { ptr = TAPE_SIZE - 1; }
        } else if c == 43 {
            tape[ptr] = tape[ptr] + 1;
        } else if c == 45 {
            tape[ptr] = tape[ptr] - 1;
        } else if c == 46 {
            putchar(tape[ptr] as i32);
        } else if c == 44 {
            tape[ptr] = getchar() as u8;
        } else if c == 91 {
            if tape[ptr] == 0 {
                pc = table[pc];
            }
        } else if c == 93 {
            if tape[ptr] != 0 {
                pc = table[pc];
            }
        }
        pc = pc + 1;
    }

    free(tape);
}

fn print_str(s: &u8) -> void {
    let i: i64 = 0;
    while s[i] != 0 {
        putchar(s[i] as i32);
        i = i + 1;
    }
}

pub fn main(argc: i32, argv: **u8) -> i32 {
    if argc < 2 {
        print_str("usage: brainfuck <file.bf>\n");
        return 1;
    }

    let filename = argv[1];
    let f = fopen(filename, "rb");
    if f == nil {
        print_str("Error: cannot open file\n");
        return 1;
    }

    fseek(f, 0, SEEK_END);
    let file_size = ftell(f);
    fseek(f, 0, SEEK_SET);
    if file_size <= 0 {
        fclose(f);
        print_str("Error: empty file\n");
        return 1;
    }

    let program = malloc(file_size as u64) as *u8;
    fread(program, 1, file_size as u64, f);
    fclose(f);
    let table = malloc((file_size * 8) as u64) as *i64;
    build_jump_table(program, file_size, table);
    execute(program, file_size, table);
    free(table);
    free(program);
    return 0;
}
