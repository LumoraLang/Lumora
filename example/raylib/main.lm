@include "raylib.lmi"
pub fn main() -> i64 {
    const RAYWHITE: i32 = 0xFFFFFFFF;
    const RED:      i32 = 0xFF0000FF;
    const width: i32 = 800;
    const height: i32 = 600;
    InitWindow(width, height, "Lumora + Raylib demo");
    while !WindowShouldClose() {
        BeginDrawing();
        ClearBackground(RAYWHITE);
        DrawText("Hello from Lumora!", 10, 10, 20 as i32, RED);
        EndDrawing();
    }

    CloseWindow();
    return 0;
}
