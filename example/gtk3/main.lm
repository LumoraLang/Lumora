@include "gtk3.lmi"
pub fn main() -> i64 {
    let argc: i32 = 0;
    gtk_init(&argc, 0 as **&u8);
    let window = gtk_window_new(0 as i32);
    gtk_window_set_title(window, "Lumora + GTK3");
    gtk_window_set_default_size(window, 400, 300);
    gtk_window_set_position(window, 1 as i32);
    g_signal_connect_data(window, "destroy", gtk_main_quit as *void, nil, nil, 0 as i32);
    let box = gtk_box_new(1 as i32, 6 as i32);
    let label = gtk_label_new("Hello from Lumora!");
    gtk_container_add(box, label);
    let button = gtk_button_new_with_label("Quit");
    g_signal_connect_data(button, "clicked", gtk_main_quit as *void, nil, nil, 0 as i32);
    gtk_container_add(box, button);
    gtk_container_add(window, box);
    gtk_widget_show_all(window);
    gtk_main();
    return 0;
}
